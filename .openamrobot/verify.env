# SPDX-License-Identifier: MIT
# Per-repository overrides for openAMRobot/.github rollout/verify.sh (job quality/test).
#
# integration/ carries COLCON_IGNORE, so colcon finds no package and the default
# ROS stages would build and test nothing (zero tests fail the gate). This gate
# runs the I2 Device Package schema/conformance suite instead.
# The fake-hardware ROS suite (integration/openarm_v2_fake_baseline) needs the
# pinned upstream workspace from its scripts/setup_workspace.sh and is not part
# of this gate yet; its results stay labelled local.
VERIFY_INSTALL='if [ "$(id -u)" = 0 ] && command -v apt-get >/dev/null; then apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq python3-yaml python3-jsonschema; fi; python3 -c "import yaml, jsonschema"'
VERIFY_BUILD='true'
VERIFY_TEST="python3 -m unittest discover -s i2/tests -p 'test_*.py' -v"
